{
  "__comment": "Haku Pi v1.2.0 - dashboard Traceur : la position (1 pt/min, en continu) sur une carte geomap. Le selecteur de duree natif de Grafana choisit la plage. Fond de carte = internet requis (meme limite documentee que la carte Leaflet). Variable bucket : haku_raw (30 j, 1 min) ou haku_agg (730 j, 10 min).",
  "uid": "haku-traceur",
  "title": "Haku — Traceur",
  "tags": ["haku"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket (haku_raw 30 j · haku_agg 730 j)",
        "type": "custom",
        "query": "haku_raw,haku_agg",
        "current": { "text": "haku_raw", "value": "haku_raw" },
        "options": [
          { "text": "haku_raw", "value": "haku_raw", "selected": true },
          { "text": "haku_agg", "value": "haku_agg", "selected": false }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "geomap",
      "title": "Trace (plage de temps sélectionnée)",
      "datasource": { "type": "influxdb", "uid": "haku-influx" },
      "gridPos": { "h": 17, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "haku-influx" },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"nav\" and (r._field == \"lat\" or r._field == \"lon\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.lat and exists r.lon)\n  |> keep(columns: [\"_time\", \"lat\", \"lon\"])\n  |> sort(columns: [\"_time\"])"
        }
      ],
      "options": {
        "view": { "id": "fit", "lastOnly": false, "padding": 5 },
        "controls": { "showZoom": true, "mouseWheelZoom": true, "showAttribution": true, "showScale": true },
        "tooltip": { "mode": "details" },
        "basemap": { "type": "default", "name": "Fond de carte" },
        "layers": [
          {
            "type": "route",
            "name": "Trace",
            "location": { "mode": "coords", "latitude": "lat", "longitude": "lon" },
            "config": {
              "style": {
                "color": { "fixed": "#3987e5" },
                "opacity": 0.9,
                "lineWidth": 2
              }
            },
            "tooltip": true
          },
          {
            "type": "markers",
            "name": "Dernière position",
            "location": { "mode": "coords", "latitude": "lat", "longitude": "lon" },
            "filterData": { "id": "byRefId", "options": "A" },
            "config": {
              "style": {
                "color": { "fixed": "#d95926" },
                "opacity": 0.9,
                "size": { "fixed": 4 },
                "symbol": { "mode": "fixed", "fixed": "img/icons/marker/circle.svg" }
              },
              "showLegend": false
            },
            "tooltip": true
          }
        ]
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Vitesse fond (SOG)",
      "datasource": { "type": "influxdb", "uid": "haku-influx" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "haku-influx" },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"nav\" and r._field == \"sog_kn\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _field: \"SOG\"}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: kn",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "custom": { "lineWidth": 1, "fillOpacity": 12, "pointSize": 3, "spanNulls": 900000 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
