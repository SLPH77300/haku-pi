# =============================================================================
# Haku Pi — généré le 27/08/2026
# /etc/haku/haku.env — TOUTE la configuration du bord dans UN fichier.
#
# install.sh copie ce fichier vers /etc/haku/haku.env s'il n'existe pas encore.
# Après modification :  sudo systemctl restart nodered
# Droits recommandés :  root:<utilisateur> 640 (posés par install.sh).
#
# AUCUN secret ne doit être commité ailleurs que dans /etc/haku/haku.env.
# Les valeurs CHANGEME_* sont des placeholders à remplacer à bord.
# =============================================================================

# --- Cerbo GX -----------------------------------------------------------------
# Adresse du Cerbo sur le réseau du bord. Préférer une IP FIXE (réservation DHCP
# dans le routeur du bord) plutôt que venus.local (mDNS moins fiable au boot).
CERBO_HOST=venus.local

# Index D-Bus du relais qui pilote le feu de mouillage.
# ATTENTION au décalage : borne « Relay 1 » du Cerbo = Relay/0 en MQTT,
# borne « Relay 2 » = Relay/1.  TODO-VERIFIER-A-BORD (procédure MQTT Explorer
# dans le README, section « Vérifier l'index du relais »).
RELAY_DBUS_INDEX=0

# --- Position & temps ---------------------------------------------------------
# Position du port d'attache (ou du mouillage habituel) pour le calcul
# lever/coucher du soleil. Exemple : Marseille.
HAKU_LAT=43.27
HAKU_LON=5.35
TZ=Europe/Paris

# Élévation du soleil (en degrés) sous laquelle il fait « nuit ».
# -0.833 = coucher/lever officiel (réfraction incluse). Mettre -6 pour ne
# déclencher qu'au crépuscule civil (feu allumé un peu plus tard).
SUN_NIGHT_ELEV=-0.833

# --- Node-RED : authentification de l'ÉDITEUR ---------------------------------
# Le hash bcrypt est généré par : sudo /opt/haku/scripts/gen-adminauth.sh
# (le script remplace la ligne NR_ADMIN_HASH ci-dessous automatiquement).
# Tant que le hash n'est pas généré, l'éditeur est verrouillé (aucun mot de
# passe ne correspond au placeholder) — le dashboard reste accessible.
NR_ADMIN_USER=admiral
NR_ADMIN_HASH=CHANGEME_LANCER_gen-adminauth.sh

# --- Alertes email (SMTP) -----------------------------------------------------
# Laisser SMTP_HOST vide pour désactiver l'envoi d'emails : les alertes restent
# visibles sur le dashboard et dans /var/lib/haku/alerts.log, et les alarmes
# VRM Victron servent de secours (voir README, section Alertes).
# Exemples : smtp.gmail.com:587 (starttls + mot de passe d'application),
#            smtp.free.fr:587, ssl0.ovh.net:465 (ssl).
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none (port 25, déconseillé)
SMTP_SECURITY=starttls
SMTP_USER=CHANGEME_utilisateur_smtp
SMTP_PASS=CHANGEME_mot_de_passe_smtp
SMTP_FROM=haku-pi@example.com
# Plusieurs destinataires possibles, séparés par des virgules.
SMTP_TO=proprietaire@example.com

# --- Tailscale (accès distant à travers le CGNAT Starlink) --------------------
# Clé d'authentification générée sur https://login.tailscale.com/admin/settings/keys
# (clé « reusable » + « pre-approved » recommandé). Utilisée UNE fois par
# install.sh pour enrôler la machine ; peut être révoquée ensuite.
TS_AUTHKEY=CHANGEME_tskey-auth-xxxxx

# Sous-réseau du bord annoncé par le Pi (subnet router) pour atteindre le
# Cerbo / Remote Console depuis l'extérieur. Adapter au plan d'adressage du
# routeur du bord. Mettre TS_ADVERTISE_ROUTES=0 pour désactiver.
SUBNET_BORD=192.168.8.0/24
TS_ADVERTISE_ROUTES=1

# --- Seuils d'alertes ---------------------------------------------------------
# IMPORTANT : PAS de commentaire en fin de ligne dans ce fichier — systemd
# (EnvironmentFile) inclurait le « # ... » DANS la valeur. Une ligne = une
# valeur nue ; les explications sont sur leur propre ligne.
# % : SOC bas
ALERT_SOC_MIN=30
# V : tension batterie basse (parc 24 V LiFePO4)
ALERT_VBAT_MIN=24.8
# °C : température batterie haute
ALERT_TBAT_MAX=45
# min : entrée AC absente avant alerte « perte du quai »
ALERT_AC_LOSS_MIN=5
# V : tension « pleine charge » à tenir…
FULLCHARGE_V=28.4
# min : …pendant ce temps pour valider la pleine charge
FULLCHARGE_HOLD_MIN=10
# j : alerte si aucune pleine charge depuis N jours
FULLCHARGE_MAX_DAYS=14
# min : silence MQTT avant alerte « Cerbo injoignable »
CERBO_TIMEOUT_MIN=15
# h : rappel d'une alerte qui persiste
ALERT_REMIND_H=24

# --- Kiosk (écran HDMI du carré) ----------------------------------------------
# 0 = mode HEADLESS (décision 29/08/2026) : pas d'écran sur le Pi — les
#     instruments sont sur les 4 écrans B&G et la batterie sur le GX Touch ;
#     consultation du dashboard sur smartphone/PC (LAN + Tailscale).
#     Image OS recommandée en headless : Raspberry Pi OS Lite 64-bit.
# 1 = kiosk Chromium plein écran sur HDMI (nécessite l'image Desktop).
KIOSK_ENABLED=0
KIOSK_URL=http://127.0.0.1:1880/dashboard/haku
# 1 = forcer la sortie HDMI même si l'écran est éteint au boot (ajoute
# video=... à /boot/firmware/cmdline.txt — voir README avant d'activer).
KIOSK_FORCE_HDMI=0
KIOSK_HDMI_MODE=1920x1080M@60D

# --- Journal quotidien --------------------------------------------------------
JOURNAL_DIR=/var/lib/haku/journal
# conservation des CSV en jours (730 = 2 ans)
JOURNAL_KEEP_DAYS=730

# =============================================================================
# v1.1 — Signal K, traces GPS, carte, flotteurs, commandes
# (rappel : AUCUN commentaire en fin de ligne — une valeur nue par ligne)
# =============================================================================

# --- Signal K (serveur du Cerbo, Venus OS Large) ------------------------------
# URL COMPLETE du flux WebSocket Signal K. Garder l'hôte cohérent avec
# CERBO_HOST (pas de substitution de variable dans ce fichier : systemd
# lit les valeurs telles quelles).
SIGNALK_URL=ws://venus.local:3000/signalk/v1/stream?subscribe=none

# --- Enregistreur de traces GPS -----------------------------------------------
# Seuil de vitesse fond (kn) au-dessus duquel une navigation peut démarrer.
TRACK_START_KN=1.5
# Durée (s) pendant laquelle SOG doit dépasser le seuil pour OUVRIR la trace.
TRACK_START_S=120
# Intervalle (s) entre deux points de trace en navigation (60 s ≈ 3-5 Ko/h).
TRACK_INTERVAL_S=60
# Immobilité (s) qui CLÔT la trace (600 = 10 min).
TRACK_STOP_S=600
# Dossier des traces GPX + index.geojson de la carte.
TRACKS_DIR=/var/lib/haku/tracks
# Fichier du journal de bord reçu du Cerbo (POST /journal) et importé.
JOURNAL_JSONL=/var/lib/haku/journal/haku_journal.jsonl

# --- Flotteurs d'envahissement (4 entrées digitales du Cerbo) -----------------
# Numéro d'INSTANCE digitalinput de chaque zone (visible dans MQTT Explorer :
# N/<id>/digitalinput/<instance>/State). VIDE = zone non câblée, tuile absente.
# TODO-VERIFIER-A-BORD : instances + valeurs 8=OK / 9=Alarme après câblage.
DIGITAL_IN_PUISARD=
DIGITAL_IN_LAZARETTE=
DIGITAL_IN_BATTERIES=
DIGITAL_IN_MACHINE=

# --- Alimentation instruments (relais 2 du Cerbo) -----------------------------
# Index D-Bus du relais qui coupe/alimente le parc instruments.
# ATTENTION au décalage : borne « Relay 2 » du Cerbo = Relay/1 en MQTT.
# TODO-VERIFIER-A-BORD comme pour le feu (README §6).
INSTR_RELAY_INDEX=1

# --- Ports déclarés & géofence ------------------------------------------------
# Rayon (m) autour d'un port déclaré : à l'intérieur, le mode MARINA s'active
# automatiquement (override manuel toujours possible).
GEOFENCE_M=150
# Rayon (m) au-delà duquel, en mode MARINA près d'un port déclaré, une alerte
# « position anormale » est envoyée (dérive de mouillage/amarres).
GEOFENCE_ALERT_M=250

# --- Prévisions Open-Meteo (sans clé, 2 requêtes / 12 h) ----------------------
# 1 = activé, 0 = désactivé (tuile prévisions à « — »).
OPEN_METEO=1

# =============================================================================
# v1.2 — Page Surveillance, InfluxDB/Grafana, Waveshare, heartbeat
# (rappel : AUCUN commentaire en fin de ligne — une valeur nue par ligne)
# =============================================================================

# --- Page Surveillance : vent enregistré 48 h ---------------------------------
# Seuil de rafale (kn) au-delà duquel une alerte email « VENT FORT » part
# (hystérésis -5 kn, rappel ALERT_REMIND_H). Échantillon toutes les 10 min,
# ring buffer 48 h persisté dans /var/lib/haku/meteo48h.json (1 écriture/10 min).
WIND_ALERT_KT=35

# --- Page Surveillance : alarme « dérive SOC à quai » -------------------------
# Quand le toggle « Surveillance à quai » est actif (persisté comme le mode
# MOUILLAGE) : un échantillon de SOC par heure ; baisse CONTINUE (aucune
# remontée > 1 point = aucune charge) pendant SURV_SOC_H heures et d'au moins
# SURV_SOC_DROP points → email « Le bateau perd de la charge à quai ».
SURV_SOC_H=48
SURV_SOC_DROP=5

# --- InfluxDB 2 (historique long : traceur, météo, électrique) ----------------
# 1 = install.sh installe et démarre InfluxDB 2 (dépôt officiel arm64, sans
# Docker) et Node-RED y écrit 1 point/min (position EN CONTINU = traceur).
INFLUX_ENABLED=1
# Répertoire des données Influx. AUJOURD'HUI sur la carte SD ; le jour où un
# SSD USB est monté (ex. /mnt/ssd) : arrêter influxdb, rsync -a de ce dossier
# vers le SSD, changer cette variable, relancer install.sh — rien d'autre.
INFLUX_DATA_DIR=/var/lib/haku/influx
# Organisation et buckets créés par install.sh (brut 30 j ; agrégé 10 min
# conservé 730 j par la tâche de downsampling — réglage « SD light »).
INFLUX_ORG=haku
INFLUX_BUCKET=haku_raw
INFLUX_BUCKET_AGG=haku_agg
# URL de l'API (locale uniquement : InfluxDB écoute sur 127.0.0.1).
INFLUX_URL=http://127.0.0.1:8086
# Jeton d'API : GÉNÉRÉ ET ÉCRIT ICI PAR install.sh au premier lancement
# (influx setup --force). Ne jamais le committer ailleurs.
INFLUX_TOKEN=
# Mot de passe admin de l'interface web Influx (127.0.0.1:8086, via tunnel
# SSH uniquement) — généré par install.sh.
INFLUX_ADMIN_PASS=

# --- Grafana (port 3001 — dashboards Traceur / Météo bord / Électrique) -------
# 1 = install.sh installe Grafana (dépôt officiel), provisionne la datasource
# Influx + 3 dashboards, et n'ouvre le port 3001 QUE depuis SUBNET_BORD et
# Tailscale (nftables). Anonyme désactivé.
GRAFANA_ENABLED=1
GRAFANA_PORT=3001
# Mot de passe admin Grafana : généré et écrit ici par install.sh au premier
# lancement. Pour le changer : sudo /opt/haku/scripts/gen-grafana-pass.sh
GRAFANA_ADMIN_PASS=

# --- Module Waveshare Modbus POE ETH Relay (B) --------------------------------
# 0 tant que le module n'est PAS câblé (voir FICHE_CABLAGE_Waveshare_Haku.md).
# Passer à 1 après câblage + réservation DHCP : les 4 flotteurs basculent des
# entrées Cerbo vers les DI du module, le bouton Instruments pilote le relais
# 1 du module, et la borne Relay 2 du Cerbo passe à l'éclairage extérieur.
WAVESHARE_ENABLED=0
# IP du module (réservation DHCP dans le Pepwave, comme le Cerbo).
WAVESHARE_HOST=
WAVESHARE_PORT=502
# Adresse esclave Modbus (défaut usine 1). TODO-VERIFIER-A-BORD.
WAVESHARE_UNIT_ID=1
# Numéro de DI (1-8) de chaque zone de cale. Vide = zone non câblée.
WAVESHARE_DI_PUISARD=1
WAVESHARE_DI_LAZARETTE=2
WAVESHARE_DI_BATTERIES=3
WAVESHARE_DI_MACHINE=4
# Polarité des DI : 0 = DI actif -> ALARME ; 1 = DI actif -> OK (contacts NF
# piqués sur les boucles 24 V existantes du folio 11 — À DÉTERMINER À
# L'OHMMÈTRE avant mise en service, voir la fiche de câblage).
WAVESHARE_DI_INVERT=0
# Relais du module (1-8) qui alimente le circuit instruments (défaut voulu :
# ON en permanence — c'est un circuit de navigation).
WAVESHARE_INSTR_RELAY=1

# --- Éclairage extérieur (spreader lights, relais 2 du CERBO) -----------------
# Index MQTT du relais Cerbo de l'éclairage : borne « Relay 2 » = Relay/1
# (même décalage borne/index que le feu, README §6). Actif seulement quand
# WAVESHARE_ENABLED=1 (avant, cette borne alimente les instruments — v1.1).
# NB v1.2 : INSTR_RELAY_INDEX (plus haut) ne sert plus qu'en mode
# WAVESHARE_ENABLED=0 et disparaîtra ensuite (voir changelog).
RELAY_LIGHT_INDEX=1
# Minuterie d'extinction automatique en minutes (0 = désactivée).
LIGHT_AUTO_OFF_MIN=0

# --- Heartbeat dead-man (healthchecks.io ou équivalent) -----------------------
# URL à « pinger » toutes les 10 min QUAND tout va bien (le Pi ne pingue que
# si /health répond : le SILENCE déclenche l'alerte côté service externe —
# c'est lui qui vous prévient si le bateau disparaît d'internet).
# Vide = désactivé. Recommandé : https://healthchecks.io (gratuit, ~négligeable
# en data : un GET de quelques centaines d'octets toutes les 10 min).
HEALTHCHECK_URL=

# --- Divers -------------------------------------------------------------------
# Rempli automatiquement par install.sh (utilisateur qui exécute Node-RED).
#HAKU_USER=pi

# ---------------------------------------------------------------------------
# v1.3 — Waveshare : contact utilisé sur chaque voie, éclairage extérieur
# ---------------------------------------------------------------------------
# NO / NC = contact physiquement câblé sur le module (borne 3 = NO, borne 1 = NC,
# borne 2 = COM). Ces variables DÉCRIVENT le câblage, elles ne le changent pas :
# si elles mentent, la commande est inversée. Voir docs/WIRING.md.
WAVESHARE_INSTR_CONTACT=NO
# Voie du module qui commande l'éclairage extérieur (spreaders) et son contact.
WAVESHARE_LIGHT_RELAY=2
WAVESHARE_LIGHT_CONTACT=NO

# ---------------------------------------------------------------------------
# v1.3 — Sondes d'environnement (Ruuvi via Cerbo) : seuils et baromètre
# ---------------------------------------------------------------------------
# Règles de température (JSON). 'match' = fragment du nom de la sonde tel qu'il
# apparaît dans VRM (CustomName), insensible à la casse. 'maxQuai' s'applique
# quand la surveillance à quai est active (bateau inoccupé, moteur froid).
TEMP_ALERT_RULES=[{"match":"engine","max":60,"maxQuai":45},{"match":"freezer","max":-10},{"match":"fridge","max":14}]
# Le dépassement doit durer autant de minutes avant d'alerter (ouvertures de
# porte, dégivrage). Hystérésis de 2 °C avant de réarmer.
TEMP_ALERT_DELAY_MIN=30
# Chute de pression sur 3 h (hPa, valeurs positives) : vigilance / alerte.
# Repères météo marine : -3 hPa/3 h = coup de vent possible, -5 = tempête probable.
BARO_DROP_WATCH=3
BARO_DROP_ALERT=5
